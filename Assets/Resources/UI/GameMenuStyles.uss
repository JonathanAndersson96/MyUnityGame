.menu-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    flex-direction: row;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 24px;
}

.menu-panel {
    padding: 10px;
    background-color: rgb(248, 248, 240);
    border-width: 3px;
    border-color: rgb(56, 64, 88);
    border-radius: 8px;
}

.entry-list {
    width: 220px;
}

.menu-button {
    height: 40px;
    margin: 2px 0;
    padding-left: 16px;
    font-size: 20px;
    -unity-text-align: middle-left;
    color: rgb(40, 40, 48);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 4px;
}

.menu-button:hover,
.menu-button:focus {
    background-color: rgb(216, 228, 248);
}

.menu-button--selected {
    -unity-font-style: bold;
}

.page {
    flex-grow: 1;
    max-width: 560px;
    min-height: 320px;
    margin-right: 16px;
}

.page__title {
    margin-bottom: 12px;
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(40, 40, 48);
}

.page__content {
    flex-grow: 1;
}

.page__back {
    align-self: flex-end;
    width: 120px;
}

.page__text {
    font-size: 18px;
    white-space: normal;
    color: rgb(96, 96, 108);
}

.party-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 8px;
    border-bottom-width: 1px;
    border-color: rgb(208, 208, 200);
}

.party-row--active {
    background-color: rgb(216, 228, 248);
}

.party-row__name,
.party-row__hp {
    font-size: 18px;
    color: rgb(40, 40, 48);
}
